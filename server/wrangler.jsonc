// Cloudflare Workers config for the Turbogol online backend (phase 1: Durable Object matches;
// phase 2: peer-to-peer signaling rooms). Local dev needs no account: `npm run dev` (= wrangler dev
// --port 8787) runs everything in workerd/miniflare, including the Durable Objects and a fake KV namespace.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turbogol",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The public game: a Workers Custom Domain on the turbo-gol.com zone (Cloudflare creates the DNS
  // record and the certificate on deploy). The workers.dev and preview URLs are off, so the game has
  // exactly one origin. Forks: put your own domain here (and in vars.VITE_ORIGINS), or remove "routes"
  // and set "workers_dev": true.
  "routes": [{ "pattern": "turbo-gol.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Without this, `wrangler dev` infers the request host from the route above: request.url would read
  // http://turbo-gol.com/..., socket URLs would point at production and the loopback exemptions
  // (origins, Turnstile) would stop applying. Pinned to the local address instead.
  "dev": { "port": 8787, "host": "127.0.0.1:8787" },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "MatchDO" },
      { "name": "MATCHMAKER", "class_name": "MatchmakerDO" },
      // Phase 2: one hibernating signaling room per P2P match (RoomDO.ts).
      { "name": "ROOM", "class_name": "RoomDO" },
      // Accounts, ratings and ranked results (AccountsDO.ts, one SQLite object for everything).
      { "name": "ACCOUNTS", "class_name": "AccountsDO" },
      // Custom-match lobbies (LobbyDO.ts, one per lobby, hibernating) and their directory (codes + public list).
      { "name": "LOBBY", "class_name": "LobbyDO" },
      { "name": "LOBBY_DIR", "class_name": "LobbyDirectoryDO" },
      // Community nodes: their control plane (NodeRegistryDO.ts, one SQLite object 'nodes-v1' near São Paulo).
      { "name": "NODES", "class_name": "NodeRegistryDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchDO", "MatchmakerDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v3", "new_sqlite_classes": ["AccountsDO", "LobbyDO", "LobbyDirectoryDO"] },
    { "tag": "v4", "new_sqlite_classes": ["NodeRegistryDO"] }
  ],
  // The game itself: the Vite build (`npm run build` at the repo root -> ../dist) is uploaded with
  // the Worker and served from the same origin, so one URL is game + API + match sockets and the
  // client needs no CORS. Only /api/*, /ws/*, /room/*, /lobby/* and /nodes/* (the community nodes' routes)
  // reach the Worker code (run_worker_first); every other path is answered by the asset layer (unknown
  // paths fall back to index.html: SPA; an installer asking /nodes/* for the launcher must never get it).
  // The Worker still falls back to env.ASSETS.fetch() for anything else it receives. The directory
  // must exist when wrangler starts: `npm run dev` here creates an empty ../dist if needed (in
  // dev the game is served by Vite on 5173, which proxies /api, /ws and /room to this port).
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/room/*", "/lobby/*", "/nodes/*"]
  },
  // Feature flags (matchmaking_off, do_disabled). The id is the official deployment's namespace; forks
  // create their own with `npx wrangler kv namespace create FLAGS` (any id works under wrangler dev).
  "kv_namespaces": [{ "binding": "FLAGS", "id": "61764fc794934a359008a53682efd9c3" }],
  // Community nodes: the replays they upload (re-simulated before a ranked result counts; a 30-day
  // lifecycle rule on the bucket) and the signed releases, installers and channel.json the nodes
  // and their launchers download. Both buckets must exist before a deploy (`npx wrangler r2 bucket create <name>`).
  "r2_buckets": [
    { "binding": "NODE_REPLAYS", "bucket_name": "turbogol-node-replays" },
    { "binding": "NODE_RELEASES", "bucket_name": "turbogol-node-releases" }
  ],
  // Workers Rate Limiting: the counters behind src/limits.ts's table, named after their limit per
  // 60 s (period 10 or 60 only). Each counts per Cloudflare location across all its isolates,
  // approximately. namespace_id is a positive integer unique in the Cloudflare account: a fork on
  // an account that already uses one of these ids picks others. `wrangler dev` simulates them.
  "ratelimits": [
    { "name": "RL_10", "namespace_id": "7310", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_30", "namespace_id": "7330", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_60", "namespace_id": "7360", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_120", "namespace_id": "7312", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_600", "namespace_id": "7313", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_1200", "namespace_id": "7311", "simple": { "limit": 1200, "period": 60 } }
  ],
  "vars": {
    "MATCH_LENGTH_SECONDS": 180,
    "REGION_OVERRIDE": "",
    // TURNSTILE_SITEKEY: the public Turnstile sitekey paired with the TURNSTILE_SECRET secret
    // (GET /api/config hands it to the browser). VITE_ORIGINS: comma-separated browser origins allowed
    // for CORS / WebSocket Origin (empty = any origin); a loopback page is always allowed while the
    // Worker itself runs under wrangler dev, so local development is unaffected. OAuth redirect URIs
    // use the request's own origin (https://turbo-gol.com in production); set PUBLIC_ORIGIN in
    // .dev.vars only to test OAuth locally.
    "TURNSTILE_SITEKEY": "0x4AAAAAAFWoRVBMSY6b0YY8",
    // "0" = the anti-bot check is on: guests and new accounts need a Turnstile token (widget in the
    // menus; the widget lists turbo-gol.com, the Worker has TURNSTILE_SECRET). "1" switches it off
    // everywhere (pre-production only). On localhost it only runs if .dev.vars sets TURNSTILE_SECRET.
    "TURNSTILE_DISABLED": "0",
    // `npm run deploy` (scripts/deploy.mjs) overrides it with a VITE_ORIGINS environment variable when set.
    "VITE_ORIGINS": "https://turbo-gol.com",
    // Community nodes. NODE_CONTROL_PUBLIC_KEY: the public half of the production control key, which
    // the nodes check their players' tickets with; its private half is the NODE_CONTROL_PRIVATE_KEY
    // secret, and a pair that does not match places nothing (an ALERT in the logs). NODES_PUBLIC_BASE:
    // where the nodes and their installers reach /nodes/*. Without the secret (local dev, forks) no
    // match ever goes to a node. NODE_TRUSTED_OPERATORS is a secret too (README, "Community nodes").
    "NODE_CONTROL_PUBLIC_KEY": "MNSk5UH2jV-V35J_ZvfgW3JVyUvXCcgMgHAbvCzFJcI",
    "NODES_PUBLIC_BASE": "https://turbo-gol.com"
  },
  // Every 5 minutes, index.ts scheduled(): the community nodes' health check (the /healthz of the
  // project's nodes, an ALERT when one fails). One NodeRegistryDO call a run, none without the node
  // settings. It flips no KV flag: matchmaking_off, do_disabled and vm_disabled are set by hand.
  "triggers": { "crons": ["*/5 * * * *"] },
  // The shared ../src/sim/wasm/rocketsim.wasm is imported as a WebAssembly.Module.
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  // A 3v3 tick costs ~0.1 ms of CPU; a 5 min match with overtime stays far below this.
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true }
}
